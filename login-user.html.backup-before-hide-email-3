<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - X Plus</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0b0f1a;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;
        }

        .container {
            width: 90%;
            max-width: 400px;
            background: #111827;
            padding: 25px;
            border-radius: 20px;
            text-align: center;
            color: white;
        }

        /* =========================
           الشعار
        ========================= */

        .logo-box {
            margin-bottom: 12px;
        }

        .logo-box img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
        }

        /* =========================
           الترحيب
        ========================= */

        .welcome-text {
            display: block;
            margin-top: 0;
            margin-bottom: 20px;
            color: #60a5fa;
            font-size: 15px;
            font-weight: bold;
            line-height: 1.6;
        }

        /* =========================
           الحقول
        ========================= */

        input {
            width: 100%;
            padding: 14px;
            margin-bottom: 12px;
            border-radius: 10px;
            border: none;
            outline: none;
            background: #1f2937;
            color: white;
            font-size: 16px;
        }

        input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        input:focus {
            outline: 2px solid #2563eb;
        }

        /* =========================
           نسيت كلمة المرور
        ========================= */

        .link {
            font-size: 12px;
            color: #60a5fa;
            cursor: pointer;
            margin-bottom: 12px;
            display: block;
        }

        .link:hover {
            text-decoration: underline;
        }

        /* =========================
           زر تسجيل الدخول
        ========================= */

        button.main-btn {
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            border: none;
            background: #2563eb;
            color: white;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 10px;
        }

        button.main-btn:hover {
            background: #1d4ed8;
        }

        button.main-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* =========================
           الرسائل
        ========================= */

        .error-msg {
            color: #f87171;
            margin-top: 10px;
            font-size: 13px;
            min-height: 20px;
        }

        .success-msg {
            color: #4ade80;
            margin-top: 10px;
            font-size: 13px;
            min-height: 20px;
        }
    </style>
</head>

<body>

<div class="container">

    <!-- =========================
         شعار الموقع
    ========================== -->

    <div class="logo-box">
        <img
            src="https://d.top4top.io/p_3867p7o0f1.png"
            alt="شعار X Plus"
        >
    </div>


    <!-- =========================
         الترحيب
    ========================== -->

    <p class="welcome-text">
        مرحباً بك في موقعنا عبر منصة X Plus
    </p>


    <!-- =========================
         البريد الإلكتروني
    ========================== -->

    <input
        type="email"
        id="email"
        placeholder="البريد الإلكتروني"
        autocomplete="email"
    >


    <!-- =========================
         كلمة المرور
    ========================== -->

    <input
        type="password"
        id="password"
        placeholder="كلمة المرور"
        autocomplete="current-password"
    >


    <!-- =========================
         نسيت كلمة المرور
    ========================== -->

    <p
        class="link"
        onclick="forgotPassword()"
    >
        نسيت كلمة المرور؟
    </p>


    <!-- =========================
         تسجيل الدخول
    ========================== -->

    <button
        class="main-btn"
        id="loginBtn"
        onclick="login()"
    >
        تسجيل الدخول
    </button>


    <!-- =========================
         رسالة الخطأ / النجاح
    ========================== -->

    <p
        class="error-msg"
        id="errorMsg"
    ></p>

</div>


<script>

/* ============================================
   العناصر
============================================ */

const emailInput =
    document.getElementById("email");

const passwordInput =
    document.getElementById("password");

const loginBtn =
    document.getElementById("loginBtn");

const errorMsg =
    document.getElementById("errorMsg");


/* ============================================
   استقبال البريد من رابط التحويل
   مثال:
   /login-user.html?email=test@example.com
============================================ */

const params =
    new URLSearchParams(window.location.search);

const emailFromUrl =
    params.get("email");

if (emailFromUrl) {

    emailInput.value =
        emailFromUrl;

}


/* ============================================
   تسجيل الدخول
============================================ */

async function login() {

    const email =
        emailInput.value.trim();

    const password =
        passwordInput.value;

    errorMsg.textContent = "";
    errorMsg.className = "error-msg";


    /* التحقق من الحقول */

    if (!email || !password) {

        errorMsg.textContent =
            "يرجى إدخال البريد الإلكتروني وكلمة المرور";

        return;
    }


    /* تعطيل الزر أثناء الطلب */

    loginBtn.disabled = true;

    loginBtn.textContent =
        "جاري تسجيل الدخول...";


    try {

        /* =====================================
           الاتصال بمسار تسجيل الدخول
        ===================================== */

        const response =
            await fetch("/api/auth/login", {

                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({

                    email: email,

                    password: password

                })

            });


        /* محاولة قراءة الاستجابة */

        const data =
            await response
                .json()
                .catch(() => ({}));


        /* =====================================
           التحقق من نجاح تسجيل الدخول
        ===================================== */

        if (
            !response.ok ||
            !data.success
        ) {

            throw new Error(
                data.message ||
                "فشل تسجيل الدخول"
            );

        }


        /* =====================================
           حفظ Token المستخدم
        ===================================== */

        if (data.token) {

            localStorage.setItem(
                "token",
                data.token
            );

            localStorage.removeItem(
                "auth_token"
            );

        }


        /* =====================================
           رسالة نجاح
        ===================================== */

        errorMsg.className =
            "success-msg";

        errorMsg.textContent =
            "✓ تم تسجيل الدخول بنجاح";


        /* =====================================
           الانتقال إلى لوحة التحكم
        ===================================== */

        setTimeout(() => {

            window.location.href = "/";

        }, 500);


    } catch (error) {

        console.error(
            "User Login Error:",
            error
        );


        /* =====================================
           عرض الخطأ
        ===================================== */

        errorMsg.className =
            "error-msg";

        errorMsg.textContent =
            "✗ " +
            (
                error.message ||
                "تعذر الاتصال بالخادم"
            );


        /* إعادة تفعيل الزر */

        loginBtn.disabled = false;

        loginBtn.textContent =
            "تسجيل الدخول";

    }

}


/* ============================================
   نسيت كلمة المرور
============================================ */

function forgotPassword() {

    window.location.href =
        "/forgot-password";

}


/* ============================================
   الضغط على Enter
============================================ */

passwordInput.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Enter") {

            login();

        }

    }
);

</script>

</body>
</html>