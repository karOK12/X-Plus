<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إعدادات الحساب - X Plus</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: #0b1120;
      color: #fff;
      font-family: Arial, sans-serif;
    }

    .container {
      width: 100%;
      max-width: 520px;
      margin: auto;
      padding: 20px 14px;
    }

    .header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }

    .back {
      width: 40px;
      height: 40px;
      border: 1px solid #374151;
      border-radius: 10px;
      background: #111827;
      color: #fff;
      cursor: pointer;
      font-size: 20px;
    }

    h1 {
      margin: 0;
      font-size: 22px;
    }

    .card {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 14px;
    }

    .card h2 {
      margin: 0 0 14px;
      font-size: 16px;
    }

    .field {
      margin-top: 12px;
    }

    label {
      display: block;
      color: #9ca3af;
      font-size: 12px;
      margin-bottom: 6px;
    }

    input {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #374151;
      border-radius: 9px;
      background: #1f2937;
      color: #fff;
      outline: none;
    }

    input:focus {
      border-color: #3b82f6;
    }

    .save {
      width: 100%;
      margin-top: 14px;
      padding: 12px;
      border: 0;
      border-radius: 9px;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      color: #fff;
      font-weight: bold;
      cursor: pointer;
    }

    .notice {
      margin-top: 10px;
      color: #9ca3af;
      font-size: 11px;
      line-height: 1.6;
    }

    .status {
      margin-top: 10px;
      font-size: 12px;
      display: none;
    }

    .success {
      color: #22c55e;
    }

    .error {
      color: #ef4444;
    }

    .settings-action {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 13px;
      margin-top: 10px;
      border: 1px solid #263244;
      border-radius: 11px;
      background: #172033;
      color: #fff;
      text-decoration: none;
      cursor: pointer;
      transition: .2s ease;
    }

    .settings-action:hover {
      background: #1d2940;
      border-color: #3b82f6;
    }

    .settings-action-icon {
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      background: #1f2937;
      font-size: 20px;
      flex-shrink: 0;
    }

    .settings-action strong {
      display: block;
      font-size: 13px;
      margin-bottom: 3px;
    }

    .settings-action small {
      display: block;
      color: #9ca3af;
      font-size: 11px;
    }

    .danger {
      border-color: #4b2228;
    }

    .danger:hover {
      background: #2a171c;
      border-color: #ef4444;
    }
  </style>
</head>

<body>

  <main class="container">

    <div class="header">
      <button class="back" onclick="history.back()" aria-label="رجوع">→</button>
      <h1>⚙️ إعدادات الحساب</h1>
    </div>

    <!-- 1. كلمة المرور -->
    <section class="card">
      <h2>🔐 كلمة المرور</h2>

      <div class="field">
        <label for="currentPassword">كلمة المرور الحالية</label>
        <div class="password-wrap">
          <input
            id="currentPassword"
            type="password"
            autocomplete="current-password"
          >
          <button type="button" class="password-toggle" data-target="currentPassword" aria-label="إظهار كلمة المرور">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/>
              <circle cx="12" cy="12" r="2.5"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="field">
        <label for="newPassword">كلمة المرور الجديدة</label>
        <div class="password-wrap">
          <input
            id="newPassword"
            type="password"
            autocomplete="new-password"
          >
          <button type="button" class="password-toggle" data-target="newPassword" aria-label="إظهار كلمة المرور">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/>
              <circle cx="12" cy="12" r="2.5"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="field">
        <label for="confirmPassword">تأكيد كلمة المرور الجديدة</label>
        <div class="password-wrap">
          <input
            id="confirmPassword"
            type="password"
            autocomplete="new-password"
          >
          <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="إظهار كلمة المرور">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/>
              <circle cx="12" cy="12" r="2.5"/>
            </svg>
          </button>
        </div>
      </div>

      <button class="save" id="passwordBtn">
        حفظ كلمة المرور
      </button>

      <div class="status" id="passwordStatus"></div>

      <div class="notice">
        لا يتم عرض كلمة المرور أو حفظها كنص مكشوف داخل الصفحة.
      </div>
    </section>

    <!-- 2. البريد الإلكتروني -->
    <section class="card">
      <h2>📧 البريد الإلكتروني</h2>

      <div class="field">
        <label for="email">البريد الإلكتروني الجديد</label>
        <input
          id="email"
          type="email"
          autocomplete="email"
          placeholder="example@email.com"
        >
      </div>

      <button class="save" type="button" id="emailBtn">
        تحديث البريد الإلكتروني
      </button>

      <div class="status" id="emailStatus"></div>
    </section>

    <!-- 3. رقم الهاتف -->
    <section class="card">
      <h2>📱 رقم الهاتف</h2>

      <div class="field">
        <label for="phone">رقم الهاتف</label>
        <input
          id="phone"
          type="tel"
          autocomplete="tel"
          placeholder="أدخل رقم الهاتف"
        >
      </div>

      <button class="save" type="button" id="phoneBtn">
        تحديث رقم الهاتف
      </button>

      <div class="status" id="phoneStatus"></div>
    </section>

    <!-- 4. الأمان وتسجيل الدخول -->
    <section class="card">
      <h2>🛡️ الأمان وتسجيل الدخول</h2>

      <a href="#" class="settings-action">
        <span class="settings-action-icon">🔑</span>
        <span>
          <strong>جلسات تسجيل الدخول</strong>
          <small>مراجعة الأجهزة والجلسات المسجلة</small>
        </span>
      </a>

      <a href="#" class="settings-action">
        <span class="settings-action-icon">🚪</span>
        <span>
          <strong>تسجيل الخروج من الأجهزة</strong>
          <small>إدارة جلسات الدخول الأخرى</small>
        </span>
      </a>

      <a href="#" class="settings-action">
        <span class="settings-action-icon">🔒</span>
        <span>
          <strong>إعدادات الأمان</strong>
          <small>إدارة وسائل حماية الحساب</small>
        </span>
      </a>
    </section>

    <!-- 5. التخزين المحلي -->
    <section class="card">
      <h2>💾 التخزين المحلي</h2>

      <p class="notice">
        هذا القسم مخصص لمعاينة البيانات المخزنة محلياً وإدارتها
        بشكل واضح وآمن.
      </p>
    </section>

    <!-- 6. حذف الحساب -->
    <section class="card">
      <h2>🗑️ حذف الحساب</h2>

      <p class="notice">
        حذف الحساب إجراء نهائي وقد يؤدي إلى حذف بيانات الحساب.
      </p>

      <button
        class="save"
        type="button"
        id="deleteAccountBtn"
        style="background:#dc2626;"
      >
        حذف الحساب نهائياً
      </button>

      <div class="status" id="deleteStatus"></div>
    </section>

  </main>

  <script>
    const passwordBtn = document.getElementById('passwordBtn');
    const passwordStatus = document.getElementById('passwordStatus');

    passwordBtn.addEventListener('click', () => {
      const current =
        document.getElementById('currentPassword').value;

      const next =
        document.getElementById('newPassword').value;

      const confirm =
        document.getElementById('confirmPassword').value;

      passwordStatus.style.display = 'block';
      passwordStatus.className = 'status';

      if (!current || !next || !confirm) {
        passwordStatus.textContent =
          '⚠️ املأ جميع الحقول.';
        passwordStatus.classList.add('error');
        return;
      }

      if (next !== confirm) {
        passwordStatus.textContent =
          '⚠️ تأكيد كلمة المرور غير مطابق.';
        passwordStatus.classList.add('error');
        return;
      }

      if (next.length < 8) {
        passwordStatus.textContent =
          '⚠️ كلمة المرور الجديدة يجب أن تكون 8 أحرف على الأقل.';
        passwordStatus.classList.add('error');
        return;
      }

      passwordStatus.textContent =
        'ℹ️ التحقق المحلي ناجح. الربط الحقيقي بالخادم نضيفه لاحقاً.';
      passwordStatus.classList.add('success');
    });


    document.getElementById('emailBtn').addEventListener('click', () => {
      const status = document.getElementById('emailStatus');
      const email = document.getElementById('email').value.trim();

      status.style.display = 'block';
      status.className = 'status';

      if (!email) {
        status.textContent = '⚠️ أدخل البريد الإلكتروني.';
        status.classList.add('error');
        return;
      }

      status.textContent =
        'ℹ️ البريد جاهز للربط بالخادم.';
      status.classList.add('success');
    });


    document.getElementById('phoneBtn').addEventListener('click', () => {
      const status = document.getElementById('phoneStatus');
      const phone = document.getElementById('phone').value.trim();

      status.style.display = 'block';
      status.className = 'status';

      if (!phone) {
        status.textContent = '⚠️ أدخل رقم الهاتف.';
        status.classList.add('error');
        return;
      }

      status.textContent =
        'ℹ️ رقم الهاتف جاهز للربط بالخادم.';
      status.classList.add('success');
    });


    document.getElementById('deleteAccountBtn').addEventListener('click', () => {
      const status = document.getElementById('deleteStatus');

      status.style.display = 'block';
      status.className = 'status error';
      status.textContent =
        '⚠️ حذف الحساب غير مفعّل حالياً لحماية بياناتك.';
    });
  </script>

</body>
</html>

<style id="password-eye-fix">
.password-wrap {
  position: relative !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
}

.password-wrap input {
  width: 100% !important;
  margin: 0 !important;
  padding-left: 46px !important;
  padding-right: 12px !important;
  display: block !important;
}

.password-toggle {
  position: absolute !important;
  left: 10px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  width: 28px !important;
  height: 28px !important;
  margin: 0 !important;
  padding: 3px !important;
  border: 0 !important;
  background: transparent !important;
  color: #94a3b8 !important;
  cursor: pointer !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 0 !important;
}

.password-toggle:hover {
  color: #3b82f6 !important;
  background: transparent !important;
}

.password-toggle svg {
  width: 20px !important;
  height: 20px !important;
  display: block !important;
  fill: none !important;
  stroke: currentColor !important;
  stroke-width: 1.8 !important;
  stroke-linecap: round !important;
  stroke-linejoin: round !important;
}

.password-toggle + * {
  margin-top: 0 !important;
}
</style>

<script id="password-toggle-script">
document.querySelectorAll('.password-toggle').forEach((button) => {
  button.addEventListener('click', () => {
    const targetId = button.getAttribute('data-target');
    const input = document.getElementById(targetId);
    if (!input) return;

    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';

    button.setAttribute(
      'aria-label',
      isHidden ? 'إخفاء كلمة المرور' : 'إظهار كلمة المرور'
    );

    button.classList.toggle('visible', isHidden);
  });
});
</script>
