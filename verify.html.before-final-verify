<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>التحقق من الحساب</title>

  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      font-family: 'Cairo', sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: #e9eef5;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 420px;
      background: #fff;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 4px 20px rgba(0,0,0,.08);
      text-align: center;
    }

    h2 {
      margin: 0 0 10px;
      color: #1a2b4a;
      font-size: 21px;
    }

    .info {
      color: #666;
      font-size: 13px;
      margin-bottom: 20px;
      line-height: 1.8;
    }

    .otp-inputs {
      display: flex;
      direction: ltr;
      justify-content: center;
      gap: 7px;
      margin: 20px 0;
    }

    .otp-box {
      width: 45px;
      height: 50px;
      border: 1px solid #ccc;
      border-radius: 8px;
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      outline: none;
    }

    .otp-box:focus {
      border-color: #1877f2;
    }

    button {
      width: 100%;
      border: none;
      border-radius: 8px;
      padding: 10px;
      background: #1877f2;
      color: white;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    button:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .alert {
      display: none;
      margin-bottom: 15px;
      padding: 10px;
      border-radius: 7px;
      font-size: 12px;
    }

    .alert.show {
      display: block;
    }

    .alert.error {
      background: #fee;
      color: #c33;
    }

    .alert.success {
      background: #efe;
      color: #287a35;
    }

    .back {
      margin-top: 12px;
      background: #6c757d;
    }
  </style>
</head>

<body>

<div class="container">

  <h2>🔐 التحقق من الحساب</h2>

  <div class="info" id="verifyInfo">
    أدخل رمز التحقق المرسل إليك
  </div>

  <div class="alert" id="alert"></div>

  <div class="otp-inputs">
    <input class="otp-box" maxlength="1" inputmode="numeric">
    <input class="otp-box" maxlength="1" inputmode="numeric">
    <input class="otp-box" maxlength="1" inputmode="numeric">
    <input class="otp-box" maxlength="1" inputmode="numeric">
    <input class="otp-box" maxlength="1" inputmode="numeric">
    <input class="otp-box" maxlength="1" inputmode="numeric">
  </div>

  <button id="verifyBtn" onclick="verifyOTP()">
    تأكيد الكود
  </button>

  <button class="back" onclick="goBack()">
    رجوع
  </button>

</div>

<script>

const API_URL = '/api';

const boxes = document.querySelectorAll('.otp-box');

const alertBox = document.getElementById('alert');
const verifyBtn = document.getElementById('verifyBtn');

function showAlert(message, type) {
  alertBox.textContent = message;
  alertBox.className = 'alert show ' + type;
}

function getOTP() {
  return Array.from(boxes)
    .map(box => box.value)
    .join('');
}

boxes.forEach((box, index) => {

  box.addEventListener('input', function () {

    this.value = this.value.replace(/[^0-9]/g, '');

    if (this.value && index < boxes.length - 1) {
      boxes[index + 1].focus();
    }

  });

  box.addEventListener('keydown', function(e) {

    if (
      e.key === 'Backspace' &&
      !this.value &&
      index > 0
    ) {
      boxes[index - 1].focus();
    }

  });

});

async function verifyOTP() {

  const code = getOTP();

  if (code.length !== 6) {
    showAlert('أدخل الكود كاملاً المكون من 6 أرقام', 'error');
    return;
  }

  const pending = JSON.parse(
    localStorage.getItem('pendingVerification') || 'null'
  );

  if (!pending || !pending.email) {
    showAlert('بيانات التحقق غير موجودة، ارجع وأرسل الكود من جديد', 'error');
    return;
  }

  verifyBtn.disabled = true;
  verifyBtn.textContent = 'جاري التحقق...';

  try {

    const token =
      localStorage.getItem('token') ||
      localStorage.getItem('auth_token');

    const headers = {
      'Content-Type': 'application/json'
    };

    if (token) {
      headers.Authorization = `Bearer ${token}`;
    }

    const response = await fetch(`${API_URL}/otp/verify`, {
      method: 'POST',
      headers,
      body: JSON.stringify({
        email: pending.email,
        otp: code
      })
    });

    const data = await response.json().catch(() => ({}));

    if (!response.ok || !data.success) {
      throw new Error(
        data.message || 'رمز التحقق غير صحيح'
      );
    }

    localStorage.setItem('otpVerified', 'true');

    showAlert('✓ تم التحقق بنجاح', 'success');

    setTimeout(() => {
      window.location.href = pending.returnUrl || '/user-data.html';
    }, 700);

  } catch (error) {

    console.error('Verify error:', error);

    showAlert(
      '✗ ' + (error.message || 'فشل التحقق'),
      'error'
    );

    verifyBtn.disabled = false;
    verifyBtn.textContent = 'تأكيد الكود';
  }
}

function goBack() {
  window.location.href = '/user-data.html';
}

const pending = JSON.parse(
  localStorage.getItem('pendingVerification') || 'null'
);

if (pending && pending.email) {

  document.getElementById('verifyInfo').textContent =
    `أدخل رمز التحقق المرسل إلى ${pending.email}`;

}

boxes[0].focus();

</script>

</body>
</html>