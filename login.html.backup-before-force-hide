<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0b0f1a;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        
        .container {
            width: 90%;
            max-width: 400px;
            background: #111827;
            padding: 25px;
            border-radius: 20px;
            text-align: center;
            color: white;
        }
        
        .logo-box {
            margin-bottom: 15px;
        }
        
        .logo-box img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .welcome-text {
            display: none;
            margin-top: -5px;
            margin-bottom: 15px;
            color: #60a5fa;
            font-size: 15px;
            font-weight: bold;
        }
        
        input {
            width: 100%;
            padding: 14px;
            margin-bottom: 12px;
            border-radius: 10px;
            border: none;
            background: #1f2937;
            color: white;
            font-size: 16px;
        }
        
        input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }
        
        .link {
            font-size: 12px;
            color: #60a5fa;
            cursor: pointer;
            margin-bottom: 10px;
            display: block;
        }
        
        .link:hover {
            text-decoration: underline;
        }
        
        button.main-btn {
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            border: none;
            background: #2563eb;
            color: white;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 10px;
        }
        
        button.main-btn:hover {
            background: #1d4ed8;
        }
        
        .social-divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 15px 0 8px;
            color: #9ca3af;
            font-size: 14px;
            font-weight: bold;
        }

        .social-divider::before,
        .social-divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #374151;
        }

        .social {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
        }
        
        .social-btn {
            flex: 1;
            margin: 0 3px;
            padding: 10px;
            border-radius: 8px;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 14px;
        }
        
        .social-btn:hover {
            opacity: 0.9;
        }
        
        .error-msg {
            color: red;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Logo -->
<div class="logo-box">
    <img src="https://d.top4top.io/p_3867p7o0f1.png" alt="شعار X Plus">
</div>

<p class="welcome-text" style="display:none;">مرحباً بك في موقع X Plus</p>

        <!-- Inputs -->
        <input type="email" id="email" placeholder="البريد الإلكتروني">
        <input type="password" id="password" placeholder="كلمة المرور">

        <!-- Links -->
        <p class="link" onclick="forgotPassword()">نسيت كلمة المرور؟</p>

        <!-- Button -->
        <button class="main-btn" onclick="login()">تسجيل الدخول</button>

        <!-- Register -->
        <p class="link" id="registerLink" onclick="register()">إنشاء حساب جديد</p>

        <!-- Social -->
        <div class="social-divider" id="socialDivider">
    <span>متابعة</span>
</div>
        <div class="social" id="socialButtons">
            <button class="social-btn" style="background: #db4437;" onclick="socialLogin('google')">Google</button>
            <button class="social-btn" style="background: #1877f2;" onclick="socialLogin('facebook')">Facebook</button>
            <button class="social-btn" style="background: #22c55e;" onclick="phoneVerification()">Phone</button>
        </div>

        <p class="error-msg" id="errorMsg"></p>
    </div>

  <script>
const emailInput = document.getElementById("email");
const loginEmail = new URLSearchParams(window.location.search).get("email");

if (loginEmail) {
    emailInput.value = loginEmail;
}

// ============================================
// التحقق من اكتمال التسجيل الداخلي
// ============================================
function checkRegistrationStatus() {

    const registrationCompleted =
        localStorage.getItem("registrationCompleted") === "true";

    if (!registrationCompleted) {
        return;
    }

    // العناصر التي يجب إخفاؤها بعد اكتمال التسجيل
    const registerLink =
        document.getElementById("registerLink");

    const socialDivider =
        document.getElementById("socialDivider");

    const socialButtons =
        document.getElementById("socialButtons");

    // إخفاء إنشاء الحساب
    if (registerLink) {
        registerLink.style.display = "none";
        registerLink.hidden = true;
    }

    // إخفاء "متابعة"
    if (socialDivider) {
        socialDivider.style.display = "none";
        socialDivider.hidden = true;
    }

    // إخفاء Google + Facebook + Phone
    if (socialButtons) {
        socialButtons.style.display = "none";
        socialButtons.hidden = true;
    }

    // إبقاء الشعار ظاهرًا
    const logoBox =
        document.querySelector(".logo-box");

    if (logoBox) {
        logoBox.style.display = "block";
        logoBox.hidden = false;
    }

    // الترحيب تحت الشعار
    const welcomeText =
        document.querySelector(".welcome-text");

    if (welcomeText) {
        welcomeText.textContent =
            "تم إنشاء حسابك بنجاح، يرجى تسجيل الدخول";

        welcomeText.style.display = "block";
        welcomeText.hidden = false;
    }

    // الحقول تبقى ظاهرة ولكن فارغة
    const email =
        document.getElementById("email");

    const password =
        document.getElementById("password");

    if (email) {
        email.value = "";
    }

    if (password) {
        password.value = "";
    }

    console.log(
        "✅ REGISTRATION COMPLETED"
    );

    console.log(
        "✅ تم إخفاء: إنشاء الحساب + متابعة + Google + Facebook + Phone"
    );

    console.log(
        "✅ تم إبقاء: الشعار + الترحيب + الحقول + نسيت كلمة المرور + تسجيل الدخول"
    );
}

// تشغيل الفحص بعد تحميل الصفحة
window.addEventListener("DOMContentLoaded", checkRegistrationStatus);
window.addEventListener("load", checkRegistrationStatus);

document.addEventListener("DOMContentLoaded", () => {
    if (localStorage.getItem("registrationCompleted") !== "true") {
        return;
    }

    // إخفاء عناصر إنشاء الحساب بعد اكتمال التسجيل
    const hideAfterRegistration = [
        document.getElementById("registerLink"),
        document.getElementById("socialDivider"),
        document.getElementById("socialButtons")
    ];

    hideAfterRegistration.forEach(el => {
        if (el) {
            el.style.display = "none";
            el.hidden = true;
        }
    });

    // إبقاء حقول تسجيل الدخول ظاهرة وفارغة
    const email = document.getElementById("email");
    const password = document.getElementById("password");

    if (email) email.value = "";
    if (password) password.value = "";

    // إظهار الترحيب بعد اكتمال التسجيل
    const welcome = document.querySelector(".welcome-text");

    if (welcome) {
        welcome.textContent =
            "تم إنشاء حسابك بنجاح، يرجى تسجيل الدخول";
        welcome.style.display = "block";
    }

    console.log("✅ POST-REGISTRATION UI ACTIVE");
});

async function login() {

    const email = emailInput.value.trim();
    const password = document.getElementById("password").value;
    const errorMsg = document.getElementById("errorMsg");

    errorMsg.textContent = "";

    if (!email || !password) {
        errorMsg.textContent = "يرجى ملء الحقول";
        return;
    }

    try {

        const response = await fetch("/api/auth/login", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                email,
                password
            })
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
            errorMsg.textContent = data.message || "فشل تسجيل الدخول";
            return;
        }

localStorage.setItem("token", data.token);
localStorage.removeItem("auth_token");

window.location.href = "/";

    } catch (error) {

        console.error(error);
        errorMsg.textContent = "تعذر الاتصال بالخادم";

    }

}

function forgotPassword() {
    window.location.href = "/forgot-password";
}

function register() {
    window.location.href = "/register.html";
}

function socialLogin(provider) {
    window.location.href = "/" + provider + "-login";
}

function phoneVerification() {
    window.location.href = "/phone";
}
</script>
</body>
</html>