<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>تقييم X Plus</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
*{
box-sizing:border-box;
-webkit-tap-highlight-color:transparent;
}

html,body{
margin:0;
padding:0;
min-height:100%;
scrollbar-width:none;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar{
display:none;
}

body{
font-family:"Cairo",sans-serif;
background:
radial-gradient(circle at 50% -10%,rgba(37,99,235,.22),transparent 38%),
linear-gradient(145deg,#050d18,#091a2d 55%,#0d2742);
color:#fff;
padding:18px 12px 35px;
}

.page{
width:100%;
max-width:680px;
margin:auto;
}

/* HEADER */

.header{
text-align:center;
padding:22px 12px 18px;
}

.logo{
width:66px;
height:66px;
margin:auto;
display:flex;
align-items:center;
justify-content:center;
border-radius:20px;
background:linear-gradient(145deg,#ffd43b,#ffb800);
box-shadow:0 10px 35px rgba(255,212,59,.18);
font-size:34px;
}

.header h1{
font-size:27px;
margin:13px 0 5px;
font-weight:800;
}

.header p{
margin:0;
color:#9fb0c3;
font-size:13px;
line-height:1.8;
}

/* CARD */

.card{
background:rgba(10,25,42,.94);
border:1px solid rgba(255,255,255,.08);
border-radius:22px;
padding:20px;
margin-bottom:14px;
box-shadow:0 15px 45px rgba(0,0,0,.22);
}

/* TOP STATS */

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:9px;
}

.stat{
text-align:center;
padding:13px 5px;
border-radius:15px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.055);
}

.stat strong{
display:block;
font-size:20px;
font-weight:800;
}

.stat span{
display:block;
margin-top:3px;
font-size:10px;
color:#91a3b7;
}

/* RATING SUMMARY */

.rating-summary{
text-align:center;
padding:5px 0 20px;
border-bottom:1px solid rgba(255,255,255,.07);
margin-bottom:20px;
}

.rating-number{
font-size:42px;
font-weight:800;
line-height:1;
direction:ltr;
}

.rating-number .star{
font-size:28px;
color:#ffd43b;
vertical-align:5px;
margin-left:3px;
}

.rating-label{
margin-top:9px;
font-size:14px;
color:#aebdce;
}

.reviews-title{
font-size:20px;
font-weight:800;
margin-bottom:12px;
}

/* REVIEW */

.review{
padding:16px 0;
border-top:1px solid rgba(255,255,255,.07);
}

.review:first-child{
border-top:0;
padding-top:4px;
}

.review-head{
display:flex;
align-items:center;
justify-content:space-between;
gap:10px;
}

.username{
font-weight:800;
font-size:14px;
}

.review-date{
font-size:10px;
color:#718399;
}

.review-stars{
direction:ltr;
color:#ffd43b;
font-size:15px;
letter-spacing:1px;
margin-top:5px;
}

.review-comment{
margin-top:8px;
font-size:13px;
color:#d8e2ec;
line-height:1.9;
white-space:pre-wrap;
overflow-wrap:anywhere;
}

.developer-reply{
margin-top:11px;
padding:11px 13px;
border-radius:12px;
background:rgba(37,99,235,.08);
border-right:3px solid #2563eb;
font-size:12px;
line-height:1.8;
color:#d8e4f0;
}

.developer-reply strong{
display:block;
color:#fff;
margin-bottom:3px;
}

/* USER COUNT */

.user-count{
text-align:center;
padding:18px;
margin-bottom:14px;
border-radius:18px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.07);
}

.user-count-icon{
font-size:25px;
}

.user-count-number{
font-size:32px;
font-weight:800;
color:#ffd43b;
line-height:1.2;
}

.user-count-title{
font-size:14px;
font-weight:700;
}

.user-count-sub{
font-size:10px;
color:#7f91a6;
margin-top:3px;
}

/* YOUR RATING */

.card-title{
font-size:20px;
font-weight:800;
margin:0 0 5px;
}

.card-subtitle{
font-size:12px;
color:#8496aa;
margin-bottom:14px;
}

.stars{
display:flex;
justify-content:center;
direction:ltr;
gap:4px;
margin:12px 0;
}

.star-button{
border:0;
background:transparent;
color:#4e6074;
font-size:46px;
padding:3px;
cursor:pointer;
line-height:1;
transition:.18s;
}

.star-button:hover,
.star-button.active{
color:#ffd43b;
transform:scale(1.08);
text-shadow:0 0 12px rgba(255,212,59,.3);
}

.rating-text{
text-align:center;
min-height:25px;
font-size:13px;
font-weight:700;
color:#ffd43b;
}

/* FORM */

.form-area{
display:none;
margin-top:14px;
}

label{
display:block;
font-size:13px;
font-weight:700;
margin-bottom:7px;
}

textarea{
width:100%;
height:125px;
resize:none;
border-radius:14px;
border:1px solid rgba(255,255,255,.09);
background:rgba(255,255,255,.045);
color:#fff;
padding:12px;
font-family:inherit;
font-size:13px;
line-height:1.8;
outline:none;
}

textarea:focus{
border-color:#2563eb;
background:rgba(255,255,255,.06);
}

textarea::placeholder{
color:#65788d;
}

.counter{
font-size:10px;
color:#718399;
text-align:left;
margin-top:4px;
}

.button{
width:100%;
border:0;
border-radius:13px;
padding:13px;
margin-top:11px;
font-family:inherit;
font-size:14px;
font-weight:800;
cursor:pointer;
}

.primary{
background:#2563eb;
color:#fff;
}

.secondary{
background:rgba(255,255,255,.055);
color:#dbe5ef;
border:1px solid rgba(255,255,255,.08);
}

.button:disabled{
opacity:.5;
cursor:not-allowed;
}

.message{
min-height:22px;
text-align:center;
font-size:12px;
font-weight:700;
margin-top:10px;
}

/* EMPTY */

.empty{
text-align:center;
padding:25px 5px;
color:#7f91a6;
font-size:12px;
line-height:1.8;
}

/* BACK */

.back{
display:block;
text-align:center;
color:#8faed3;
text-decoration:none;
font-size:12px;
margin-top:18px;
}

/* MOBILE */

@media(max-width:500px){

body{
padding:10px 9px 25px;
}

.card{
padding:17px;
border-radius:19px;
}

.header h1{
font-size:23px;
}

.logo{
width:58px;
height:58px;
font-size:30px;
}

.stats{
gap:6px;
}

.stat strong{
font-size:18px;
}

.stat span{
font-size:9px;
}

.star-button{
font-size:40px;
}

.rating-number{
font-size:38px;
}

}
</style>

<style>
