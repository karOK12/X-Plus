}

/* المراجعات */

#reviews{
  direction:rtl;
  text-align:right;
}

.review{
  direction:rtl;
  text-align:right;
  padding:17px 0;
  border-top:1px solid rgba(255,255,255,.07);
}

.review-head{
  direction:rtl;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.username{
  color:#ffffff;
  font-size:15px;
  font-weight:800;
}

.review-date{
