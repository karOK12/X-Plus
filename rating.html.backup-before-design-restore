<script>

const API_URL="/api";

let selectedRating=null;

const stars=document.querySelectorAll(".star-button");
const ratingText=document.getElementById("ratingText");
const formArea=document.getElementById("formArea");
const comment=document.getElementById("comment");
const charCount=document.getElementById("charCount");
const sendBtn=document.getElementById("sendBtn");

const commentOnlyBtn=
document.getElementById("commentOnlyBtn");

const commentOnlyArea=
document.getElementById("commentOnlyArea");

const commentOnly=
document.getElementById("commentOnly");

const commentOnlyCount=
document.getElementById("commentOnlyCount");

const submitCommentOnly=
document.getElementById("submitCommentOnly");

const message=document.getElementById("message");

const reviews=document.getElementById("reviews");


function getToken(){

return localStorage.getItem("token") ||
localStorage.getItem("auth_token");

}


function apiFetch(url,options={}){

const token=getToken();

return fetch(url,{

...options,

headers:{
"Content-Type":"application/json",

...(token
?{Authorization:`Bearer ${token}`}
:{ }),

...(options.headers||{})
}

});

}


function showStars(value){

stars.forEach(star=>{

const rating=Number(star.dataset.rating);

star.classList.toggle(
"active",
value &&
rating<=Number(value)
);

});

}


stars.forEach(star=>{

star.addEventListener("click",()=>{

selectedRating=
Number(star.dataset.rating);

showStars(selectedRating);

ratingText.textContent=
`${selectedRating} من 5 ⭐`;

formArea.style.display="block";

commentOnlyArea.style.display="none";

message.textContent="";

});

});


comment.addEventListener("input",()=>{

charCount.textContent=
comment.value.length;

});


commentOnly.addEventListener("input",()=>{

commentOnlyCount.textContent=
commentOnly.value.length;

});


function escapeHtml(value){

return String(value||"")

.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


function formatDate(value){

if(!value)return "";

try{

return new Date(value).toLocaleDateString(
"ar-IQ",
{
year:"numeric",
month:"long",
day:"numeric"
}
);

}catch{

return "";

}

}


function renderStars(rating){

const n=Number(rating)||0;

return "★".repeat(n)+
"☆".repeat(5-n);

}


function updateStats(stats){

if(!stats)return;

const average =
Number(stats.averageRating || 0);

const total =
Number(stats.totalRatings || 0);

const averageElement =
document.getElementById("averageRating");

if(averageElement){
  averageElement.textContent =
    average.toFixed(1);
}

const totalElement =
document.getElementById("googleTotalRatings");

if(totalElement){
  totalElement.textContent = total;
}

const storeRating =
document.getElementById("storeRating");

if(storeRating){
  storeRating.textContent = total;
}

const userRatingCount =
document.getElementById("userRatingCount");

if(userRatingCount){
  userRatingCount.textContent = total;
}

const rounded =
Math.max(0,Math.min(5,Math.round(average)));

const averageStars =
document.getElementById("averageStars");

if(averageStars){

  averageStars.textContent =
    "★".repeat(rounded) +
    "☆".repeat(5-rounded);
}

const distribution =
stats.distribution || {};

for(let i=1;i<=5;i++){

  const count =
    Number(distribution[i] || 0);

  const countElement =
    document.getElementById(`count${i}`);

  const barElement =
    document.getElementById(`bar${i}`);

  if(countElement){
    countElement.textContent = count;
  }

  if(barElement){

    const percentage =
      total > 0
      ? (count / total) * 100
      : 0;

    barElement.style.width =
      `${percentage}%`;
  }
}

}


function renderReviews(items){

if(!Array.isArray(items)||!items.length){

reviews.innerHTML=`
<div class="empty">
لا توجد مراجعات بعد.<br>
كن أول من يشارك تجربته.
</div>`;

return;

}


reviews.innerHTML=items.map(review=>{

const starsHtml=
review.rating
?`
<div class="review-stars">
${renderStars(review.rating)}
</div>
`
:"";


const reply=
review.developerReply
?`
<div class="developer-reply">
<strong>رد فريق X Plus</strong>
${escapeHtml(review.developerReply)}
</div>
`
:"";


return`

<article class="review">

<div class="review-head">

<div class="username">
${escapeHtml(review.username||"مستخدم")}
</div>

<div class="review-date">
${formatDate(review.createdAt)}
</div>

</div>

${starsHtml}

<div class="review-comment">
${escapeHtml(review.comment||"")}
</div>

${reply}

</article>

`;

}).join("");

}


async function loadRating(){

if(!getToken()){

window.location.href="login.html";

return;

}


try{

const res=
await apiFetch(`${API_URL}/rating`);

const data=
await res.json();

if(!res.ok||!data.success){

throw new Error(
data.message||
"تعذر تحميل المراجعات"
);

}

updateStats(data.stats);

renderReviews(data.reviews);


if(
data.rating!==null &&
data.rating!==undefined &&
Number(data.rating)>=1
){

selectedRating=
Number(data.rating);

showStars(selectedRating);

ratingText.textContent=
"تم تسجيل تقييمك";

}

if(data.comment){

comment.value=data.comment;

charCount.textContent=
data.comment.length;

}

}catch(error){

console.error(error);

reviews.innerHTML=`
<div class="empty">
تعذر تحميل المراجعات حاليًا.
</div>`;

}

}


async function submitRating(){

const text=
comment.value.trim();

if(!selectedRating&&!text){

message.textContent=
"⚠️ اختر تقييمًا أو اكتب تعليقًا.";

return;

}

sendBtn.disabled=true;

message.textContent=
"⏳ جاري نشر المراجعة...";


try{

const res=
await apiFetch(`${API_URL}/rating`,{

method:"POST",

body:JSON.stringify({

rating:selectedRating,
comment:text||null

})

});


const data=
await res.json();

if(!res.ok||!data.success){

throw new Error(
data.message||
"فشل نشر المراجعة"
);

}

message.textContent=
"✅ تم حفظ مراجعتك بنجاح.";

await loadRating();

}catch(error){

message.textContent=
`❌ ${error.message}`;

}finally{

sendBtn.disabled=false;

}

}


sendBtn.addEventListener(
"click",
submitRating
);


commentOnlyBtn.addEventListener("click",()=>{

formArea.style.display="none";

commentOnlyArea.style.display="block";

commentOnly.focus();

message.textContent="";

});


submitCommentOnly.addEventListener(
"click",
async()=>{

const text=
commentOnly.value.trim();

if(!text){

message.textContent=
"⚠️ اكتب تعليقك أولًا.";

return;

}

submitCommentOnly.disabled=true;

message.textContent=
"⏳ جاري نشر التعليق...";


try{

const res=
await apiFetch(`${API_URL}/rating`,{

method:"POST",

body:JSON.stringify({

rating:null,
comment:text

})

});


const data=
await res.json();

if(!res.ok||!data.success){

throw new Error(
data.message||
"فشل نشر التعليق"
);

}

message.textContent=
"✅ تم نشر تعليقك بنجاح.";

commentOnly.value="";

commentOnlyCount.textContent="0";

commentOnlyArea.style.display="none";

await loadRating();

}catch(error){

message.textContent=
`❌ ${error.message}`;

}finally{

submitCommentOnly.disabled=false;

}

});


loadRating();

</script>

