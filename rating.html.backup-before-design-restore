</header>


<!-- الإحصائيات -->

<section class="card">

<div class="stats">

<div class="stat">
<strong id="downloadCount">0</strong>
<span>عمليات تنزيل</span>
</div>

<div class="stat">
<strong>13+</strong>
<span>الفئة العمرية</span>
