<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="style.css">

    <title>X Plus</title>

    <style>

        * {
            box-sizing: border-box;
        }

        html {
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
        }

        body {
            margin: 0;
            width: 100%;
            min-height: 100vh;

            font-family: Arial, sans-serif;

            background: #0b0f1a;
            color: white;

            overflow-x: hidden;
        }


        /* =========================
           HEADER
        ========================= */

        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 25px;

            padding: 15px 25px;

            background: #111827;

            direction: ltr;
        }


        /* =========================
           LOGO
        ========================= */

        .logo-container {
            display: flex;
            align-items: center;

            gap: 10px;

            color: white;
            text-decoration: none;

            min-width: 150px;
        }

        .logo-container img {
            width: 42px;
            height: 42px;

            border-radius: 50%;

            object-fit: cover;
        }

        .brand-name {
            font-size: 18px;
            font-weight: bold;
        }


        /* =========================
           SEARCH
        ========================= */

        .search-box {
            flex: 1;
            max-width: 500px;
        }

        .search-box input {
            width: 100%;

            padding: 12px 16px;

            border-radius: 10px;

            border: 1px solid #273244;

            outline: none;

            background: #1f2937;
            color: white;

            font-size: 15px;

            direction: rtl;
        }

        .search-box input::placeholder {
            color: #9ca3af;
        }

        .search-box input:focus {
            border-color: #2563eb;
        }


        /* =========================
           ACTIONS
        ========================= */

        .actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;

            min-width: 150px;
        }


        /* =========================
           BUTTON
        ========================= */

        .btn {
            padding: 10px 20px;

            border-radius: 8px;

            text-decoration: none;

            border: none;

            cursor: pointer;

            font-size: 15px;
            font-weight: bold;

            transition: 0.2s ease;
        }

        .subscribe {
            background: #22c55e;
            color: white;
        }

        .subscribe:hover {
            background: #16a34a;

            transform: translateY(-1px);
        }


        /* =========================
           PROFILE
        ========================= */

        .profile {
            display: none;
        }

        .profile img {
            width: 42px;
            height: 42px;

            border-radius: 50%;

            object-fit: cover;
        }


        /* =========================
           MAIN
        ========================= */

        .hero {
            text-align: center;

            padding: 70px 20px 40px;
        }


            }

        }



/* =========================
   MOVING TEXT
========================= */

.youtube-ad-marquee {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto 30px;
    overflow: hidden;
    background: #111827;
    border: 1px solid #273244;
    border-radius: 12px;
    padding: 14px 0;
    white-space: nowrap;
    direction: ltr;
}

.marquee-content {
    display: inline-flex;
    align-items: center;
    gap: 45px;
    padding-left: 100%;
    animation: xplusMarquee 25s linear infinite;
}

.marquee-content span {
    color: #60a5fa;
    font-size: 16px;
    font-weight: bold;
    display: inline-block;
}

@keyframes xplusMarquee {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-100%);
    }
}

.youtube-ad-marquee:hover .marquee-content {
    animation-play-state: paused;
}

        /* =========================
           HERO TITLE
        ========================= */

        .hero h1 {
            margin-top: 30px;

            margin-bottom: 15px;

            font-size: 34px;
        }

        .hero p {
            color: #9ca3af;

            font-size: 17px;
        }


        /* =========================
           REF
        ========================= */

        #reference {
            display: none;

            color: white;

            margin-top: 20px;
        }


        /* =========================
           SCROLL CONTENT
        ========================= */

        .scroll-content {
            width: 100%;

            max-width: 1100px;

            margin: 0 auto;

            padding: 20px 20px 100px;

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 25px;
        }


        /* =========================
           SCROLL CARD
        ========================= */

        .scroll-card {
            min-height: 220px;

            padding: 30px;

            background: #111827;

            border: 1px solid #273244;

            border-radius: 16px;

            text-align: center;

            transition:
                transform 0.3s ease,
                border-color 0.3s ease;
        }

        .scroll-card:hover {
            transform: translateY(-5px);

            border-color: #2563eb;
        }

        .scroll-card h2 {
            margin: 0 0 15px;

            font-size: 22px;
        }

        .scroll-card p {
            margin: 0;

            color: #9ca3af;

            font-size: 16px;

            line-height: 1.8;
        }


        /* =========================
           AD
        ========================= */

        .ad-container {
            width: 728px;

            max-width: 100%;

            min-height: 90px;

            margin: 30px auto;

            display: flex;

            justify-content: center;

            align-items: center;
        }


        #ad-box {
            max-width: 100%;
        }


        /* =========================
           FOOTER
        ========================= */

        .footer {
            margin-top: 80px;

            padding: 25px;

            text-align: center;

            background: #111827;
        }

        .footer-one-row {
            display: flex;

            justify-content: center;

            gap: 25px;

            margin-bottom: 15px;

            flex-wrap: wrap;
        }

        .footer a {
            color: #60a5fa;

            text-decoration: none;

            transition: 0.2s ease;
        }

        .footer a:hover {
            color: #93c5fd;
        }

        .rights {
            color: #9ca3af;

            font-size: 14px;
        }


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 800px) {

            .navbar {
                flex-wrap: wrap;

                padding: 12px 18px;
            }

            .logo-container {
                min-width: auto;
            }

            .actions {
                min-width: auto;
            }

            .search-box {
                order: 3;

                flex-basis: 100%;

                max-width: none;
            }

            .hero {
                padding-top: 45px;
            }

            .hero h1 {
                font-size: 27px;
            }


            /* المحتوى يصبح عمود واحد */

            .scroll-content {
                grid-template-columns: 1fr;

                padding:
                    20px 15px 80px;
            }

            .scroll-card {
                min-height: 180px;

                padding: 25px 20px;
            }

        }


        /* =========================
           SMALL MOBILE
        ========================= */

        @media (max-width: 500px) {

            .navbar {
                gap: 12px;

                padding: 12px 15px;
            }

            .logo-container img {
                width: 38px;
                height: 38px;
            }

            .brand-name {
                font-size: 15px;
            }

            .btn {
                padding: 9px 15px;

                font-size: 14px;
            }

            .hero {
                padding: 35px 15px;
            }

            .hero h1 {
                font-size: 24px;
            }

            .hero p {
                font-size: 15px;
            }

            .footer-one-row {
                gap: 15px;

                font-size: 14px;
            }

            .scroll-card h2 {
                font-size: 20px;
            }

            .scroll-card p {
                font-size: 14px;
            }

        }

    </style>
</head>

<body>


