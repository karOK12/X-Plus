    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>


        /* =========================
           البحث
        ========================= */

        async function handleSearch() {

            const searchInput =
                document.getElementById(
                    "searchInput"
                );


            const search =
                searchInput.value.trim();


            if (!search) {
                return;
            }


            try {

                const response =
                    await fetch(
                        "/api/search?q=" +
                        encodeURIComponent(search)
                    );


                const data =
                    await response.json();


                console.log(
                    "نتائج البحث:",
                    data
                );


            } catch (error) {

                console.error(
                    "Search error:",
                    error
                );

            }

        }


        document
            .getElementById("searchInput")
            .addEventListener(
                "keydown",
                function(event) {

                    if (event.key === "Enter") {

                        handleSearch();

                    }

                }
            );


        /* =========================
           الإعلان
        ========================= */

        window.addEventListener(
            "load",
            function() {

                const box =
                    document.getElementById(
                        "ad-box"
                    );


                if (!box) {
                    return;
                }


                box.innerHTML = "";


                const script =
                    document.createElement(
                        "script"
                    );


                script.src =
                    "https://www.highperformanceformat.com/29101711/invoke.js";


                script.async = true;


                box.appendChild(script);

            }
        );


        /* =========================
           REF
        ========================= */

        const params =
            new URLSearchParams(
                window.location.search
            );


        const reference =
            params.get("ref");


        if (reference) {

            const referenceElement =
                document.getElementById(
                    "reference"
                );


            referenceElement.textContent =
                "REF: " + reference;


            referenceElement.style.display =
                "block";

        }


        /* =========================
           LOGIN
        ========================= */

        const token =
            localStorage.getItem(
                "token"
            );


        if (token) {

            const profile =
                document.getElementById(
                    "profile"
                );


            const subscribe =
                document.querySelector(
                    ".subscribe"
                );


            if (profile) {

                profile.style.display =
                    "block";

            }


            if (subscribe) {

                subscribe.style.display =
                    "none";

            }

        }

    </script>

