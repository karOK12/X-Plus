  <script>
    const RING_CX = 70;
    const RING_CY = 70;
    const RING_R  = 62;
    const RING_CIRC = 2 * Math.PI * RING_R;
    
    const CYCLE_SECONDS = 86400;
    const RING_CYCLE    = 60;
    const SCALE = 100000000;
    
    let balanceScaled = 0;
    let currentPower = 150.50;
    let isMining = false;
    let sessionDone = false;
    let startTime = 0;
    let timerInterval = null;
    let balanceInterval = null;
    let lastSecond = -1;
    let lastBalanceSecond = -1;

    function formatScaled(scaled) {
      const isNeg = scaled < 0;
      const abs = Math.abs(scaled);
      const intPart = Math.floor(abs / SCALE);
      const fracPart = (abs % SCALE).toString().padStart(8, '0');
      return (isNeg ? '-' : '') + intPart + '.' + fracPart;
    }

    function profitPerMsScaled() {
      return (currentPower * 0.00000024 * SCALE) / 3600000;
    }

    async function apiFetch(url, options = {}) {
      const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
      const headers = { 'Content-Type': 'application/json', ...options.headers };
      if (token) headers['Authorization'] = `Bearer ${token}`;
      
      const response = await fetch(url, { ...options, headers });
      if (response.status === 401) {
        localStorage.removeItem('token');
        localStorage.removeItem('auth_token');
        if (window.location.pathname !== '/login.html') window.location.href = 'login.html';
        throw new Error('انتهت صلاحية الجلسة');
      }
      if (!response.ok) {
        const error = await response.json().catch(() => ({ message: 'خطأ في الخادم' }));
        throw new Error(error.message || `HTTP ${response.status}`);
      }
      return response;
    }
    
    const API_URL = window.location.hostname === 'localhost' 
      ? 'http://localhost:3000/api'
      : '/api';

    const mobileToggle = document.getElementById('mobileToggle');
    const navMenu = document.getElementById('navMenu');
    if (mobileToggle && navMenu) {
      mobileToggle.addEventListener('click', () => { navMenu.classList.toggle('active'); });
      document.querySelectorAll('.nav-link').forEach(link => { 
        link.addEventListener('click', () => { navMenu.classList.remove('active'); }); 
      });
    }

    document.querySelectorAll('.faq-question').forEach(question => {
      question.addEventListener('click', () => { 
        question.parentElement.classList.toggle('active'); 
      });
    });

    const circle = document.getElementById('progressCircle');
    const dot = document.getElementById('progressDot');
    const radius = 62;
    const circumference = 2 * Math.PI * radius;
    circle.style.strokeDasharray = circumference;
    circle.style.strokeDashoffset = circumference;

    const balanceEl = document.getElementById('balance');
    const pointsEl = document.getElementById('points');
    const powerEl = document.getElementById('power');
    const rateEl = document.getElementById('rate');
    const timerEl = document.getElementById('timer');
    const profitInfoEl = document.getElementById('profitInfo');
    const startBtn = document.getElementById('startBtn');
    const adBtn = document.getElementById('adBtn');

    function resetRing() {
      circle.style.strokeDasharray  = RING_CIRC;
      circle.style.strokeDashoffset = RING_CIRC;
      dot.setAttribute('cx', (RING_CX + RING_R).toFixed(3));
      dot.setAttribute('cy', RING_CY);
    }

    function stopMining() {
      isMining = false;
      if (timerInterval)   { clearInterval(timerInterval);   timerInterval   = null; }
      if (balanceInterval) { clearInterval(balanceInterval); balanceInterval = null; }
      startBtn.disabled = false;
      startBtn.innerText = "⛏️ ابدأ التعدين الآن";
      profitInfoEl.textContent = "⏱️ جاهز للبدء";
    }

    function startLocalCounter() {
      if (balanceInterval) { clearInterval(balanceInterval); balanceInterval = null; }
      if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }

      const profitPerMs = profitPerMsScaled();

      function tick() {
        if (!isMining) return;
        const now = Date.now();
        const elapsedMs = now - startTime;
        balanceScaled = profitPerMs * elapsedMs;
        const sec = Math.floor(elapsedMs / 1000);
        if (sec !== lastBalanceSecond) {
          lastBalanceSecond = sec;
          balanceEl.textContent = formatScaled(Math.floor(balanceScaled));
        }
      }

      tick();
      balanceInterval = setInterval(tick, 100);
      timerInterval = setInterval(() => { updateTimer(); }, 100);
    }

    function updateRing(elapsedSeconds) {
      const t = Math.max(0, Math.min(elapsedSeconds, CYCLE_SECONDS));
      const done = elapsedSeconds >= CYCLE_SECONDS;
      const speedFactor = 0.1;
      const fill = done ? 1 : ((t * speedFactor) % RING_CYCLE) / RING_CYCLE;

      circle.style.strokeDasharray = RING_CIRC;
      circle.style.strokeDashoffset = (RING_CIRC * (1 - fill)).toFixed(3);

      const angle = fill * 2 * Math.PI;
      dot.setAttribute('cx', (RING_CX + RING_R * Math.cos(angle)).toFixed(3));
      dot.setAttribute('cy', (RING_CY + RING_R * Math.sin(angle)).toFixed(3));
    }

    async function initPage() {
      resetRing();
      try {
        const res = await apiFetch(`${API_URL}/user/init`);
        const data = await res.json();
        if (data.success) {
          const depAddr = document.getElementById('depositAddress');
          if (depAddr) depAddr.innerText = data.depositAddress;
          balanceScaled = 0;
          balanceEl.textContent = '0.00000000';
          pointsEl.textContent = data.points;
          currentPower = parseFloat(data.power) || 150.50;
          powerEl.textContent = currentPower.toFixed(2);
          rateEl.textContent = `↗️ +${(currentPower * 0.5).toFixed(2)}/h`;
          profitInfoEl.textContent = '⏱️ جاهز للبدء';
        }
      } catch (e) {
        console.error("فشل الاتصال بالخادم:", e.message);
        balanceEl.textContent = '0.00000000';
        powerEl.textContent = currentPower.toFixed(2);
        rateEl.textContent = `↗️ +${(currentPower * 0.5).toFixed(2)}/h`;
      }
    }

    initPage();

    async function startMining() {

      const token =
        localStorage.getItem('token') ||
        localStorage.getItem('auth_token');

      if (!token) {
        window.location.href = 'login.html';
        return;
      }

      if (isMining || timerInterval || balanceInterval) return;
      startBtn.disabled = true;
      startBtn.innerText = "⏳ جاري الاتصال بـ Neon DB...";
      startTime = Date.now();
      isMining = true;
      sessionDone = false;
      balanceScaled = 0;
      lastSecond = -1;
      lastBalanceSecond = -1;
      balanceEl.textContent = '0.00000000';
      timerEl.textContent = '00:00:00';
      resetRing();
      updateTimer();
      updateRing(0);
      startLocalCounter();
      
      try {
        const response = await apiFetch(`${API_URL}/mining/start`, { method: 'POST' });
        const data = await response.json();
        if (data.success) {
          startBtn.innerText = "⛏️ جاري التعدين (متصل)";
          profitInfoEl.textContent = "✅ متصل بالخادم - دورة 24 ساعة";
          if (!window._pointsUpdater) {
            window._pointsUpdater = setInterval(async () => {
              try {
                const res = await apiFetch(`${API_URL}/user/init`);
                const data = await res.json();
                if (data.success) pointsEl.textContent = data.points;
              } catch(e) {}
            }, 30000);
          }
        } else {
          stopMining();
        }
      } catch (error) {
        console.error("فشل بدء التعدين:", error);
        stopMining();
        profitInfoEl.textContent = "❌ تأكد من تشغيل server.js";
      }
    }

    async function watchAd() {
      adBtn.innerHTML = "⏳ جاري عرض الإعلان...";
      adBtn.disabled = true;
      setTimeout(async () => {
        try {
          const res = await apiFetch(`${API_URL}/ad/watch`, { method: 'POST' });
          const data = await res.json();
          if(data.success) {
            pointsEl.textContent = data.points;
            adBtn.innerHTML = "✅ تمت إضافة 10 نقاط!";
            adBtn.style.background = "rgba(34, 197, 94, 0.2)";
            adBtn.style.borderColor = "#22c55e";
            setTimeout(() => {
              adBtn.innerHTML = "📺 شاهد إعلان (+10 نقاط)";
              adBtn.disabled = false;
              adBtn.style.background = "";
              adBtn.style.borderColor = "";
            }, 3000);
          }
        } catch(e) { 
          console.error("فشل مشاهدة الإعلان:", e.message);
          adBtn.innerHTML = "📺 شاهد إعلان (+10 نقاط)";
          adBtn.disabled = false;
        }
      }, 3000);
    }

    function updateTimer() {
      if (!isMining) return;
      const now = Date.now();
      const elapsedMs = now - startTime;
      const elapsedSeconds = elapsedMs / 1000;
      const elapsed = Math.min(elapsedSeconds, CYCLE_SECONDS);
      const h = String(Math.floor(elapsed / 3600)).padStart(2, '0');
      const m = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
      const s = String(Math.floor(elapsed % 60)).padStart(2, '0');
      timerEl.textContent = `${h}:${m}:${s}`;
      updateRing(elapsedSeconds);
      if (elapsedSeconds >= CYCLE_SECONDS && !sessionDone) {
        sessionDone = true;
        isMining = false;
        if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
        if (balanceInterval) { clearInterval(balanceInterval); balanceInterval = null; }
        timerEl.textContent = '24:00:00';
        balanceEl.textContent = formatScaled(Math.floor(balanceScaled));
        updateRing(CYCLE_SECONDS);
        profitInfoEl.textContent = '🎉 اكتملت دورة الـ 24 ساعة';
        startBtn.disabled = false;
        startBtn.innerText = '⛏️ بدء دورة جديدة';
      }
    }

    const termsContent = {
      terms: `<h2>📋 الشروط والأحكام</h2><p>يتم جمع النقاط والإيداعات لتحضير توزيع عملة X Plus الرسمية.</p>`,
      privacy: `<h2>🔐 سياسة الخصوصية</h2><p>نحترم خصوصيتك ونحمي بياناتك.</p>`
    };
    
    function openTerms(type) {
      document.getElementById('termsBody').innerHTML = termsContent[type];
      document.getElementById('termsModal').classList.add('active');
    }
    
    function closeTerms() { 
      document.getElementById('termsModal').classList.remove('active'); 
    }
    
    document.getElementById('termsModal').addEventListener('click', (e) => { 
      if (e.target.id === 'termsModal') closeTerms(); 
    });

    /* ═══════════════════════════════════════════════════════════
       💰 فتح المحفظة مباشرة — بدون أي ربط بالتسجيل
       سطر واحد فقط: يفتح wallet.html في نافذة جديدة
    ═══════════════════════════════════════════════════════════ */
    function openWallet(event) {
      if (event) event.preventDefault();
      window.open('wallet.html', '_blank');
    }
    /* ================= SIDEBAR CONTROL ================= */

    const sidebarToggle = document.getElementById("sidebarToggle");
    const leftSidebar = document.getElementById("leftSidebar");
    const sidebarClose = document.getElementById("sidebarClose");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
      leftSidebar.classList.add("active");
      sidebarOverlay.classList.add("active");
      document.body.style.overflow = "hidden";
    }

    function closeSidebar() {
      leftSidebar.classList.remove("active");
      sidebarOverlay.classList.remove("active");
      document.body.style.overflow = "";
    }

    if (sidebarToggle) {
      sidebarToggle.addEventListener("click", openSidebar);
    }

    if (sidebarClose) {
      sidebarClose.addEventListener("click", closeSidebar);
    }

    if (sidebarOverlay) {
      sidebarOverlay.addEventListener("click", closeSidebar);
    }

    /* ================= END SIDEBAR CONTROL ================= */

  </script>


</body>
