<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#06101d">

<title>تقييم التطبيق - X Plus</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
box-sizing:border-box;
-webkit-tap-highlight-color:transparent;
}

html{
scrollbar-width:none;
}

html::-webkit-scrollbar{
display:none;
}

body{
margin:0;
min-height:100vh;
padding:18px 12px 30px;
font-family:"Cairo",sans-serif;
color:#fff;

background:
radial-gradient(
circle at 50% -10%,
rgba(37,99,235,.18),
transparent 38%
),
linear-gradient(
145deg,
#06101d 0%,
#0b1d32 55%,
#102844 100%
);
}

button,
textarea{
font:inherit;
}

.page{
width:100%;
max-width:720px;
margin:auto;
}

/* =========================
   البطاقات
========================= */

.card{
background:rgba(13,28,47,.94);
border:1px solid rgba(255,255,255,.08);
border-radius:22px;
box-shadow:0 16px 45px rgba(0,0,0,.22);
margin-bottom:14px;
}

/* =========================
   الهيدر
========================= */

.hero{
text-align:center;
padding:27px 20px 23px;
}

.hero-icon{
width:62px;
height:62px;
margin:0 auto 12px;

display:flex;
align-items:center;
justify-content:center;

border-radius:18px;

background:rgba(255,212,59,.10);

font-size:32px;
}

h1{
margin:0 0 7px;
font-size:25px;
font-weight:800;
}

.subtitle{
color:#aebdce;
font-size:13px;
line-height:1.9;
}

/* =========================
   الإحصائيات
========================= */

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:9px;
margin-top:20px;
direction:ltr;
}

.stat{
min-width:0;
padding:12px 6px;

border:1px solid rgba(255,255,255,.06);
border-radius:14px;

background:rgba(255,255,255,.045);

text-align:center;
}

.stat strong{
display:block;
font-size:20px;
font-weight:800;
line-height:1.3;
}

.stat span{
display:block;
margin-top:3px;
color:#91a3b7;
font-size:10px;
line-height:1.5;
}

.stat .age{
font-size:19px;
}

/* =========================
   قسم التقييم
========================= */

.rate-card{
padding:22px 18px;
}

.section-title{
margin:0 0 4px;
font-size:20px;
font-weight:800;
}

.section-subtitle{
color:#8193a8;
font-size:12px;
}

/* النجوم التي يضغط عليها المستخدم */

.stars-input{
display:flex;
justify-content:center;
direction:ltr;
gap:5px;
margin:15px 0 7px;
}

.star-button{
width:48px;
height:48px;

padding:0;
border:0;

background:transparent;

color:#536477;

font-size:40px;
line-height:1;

cursor:pointer;

transition:
transform .15s ease,
color .15s ease;
}

.star-button:hover{
transform:scale(1.08);
color:#ffd43b;
}

.star-button.active{
color:#ffd43b;

text-shadow:
0 0 12px rgba(255,212,59,.28);
}

.rating-hint{
min-height:25px;

text-align:center;

color:#ffd43b;

font-size:13px;
font-weight:700;
}

/* =========================
   التعليق
========================= */

.label{
display:block;
margin:17px 0 7px;

font-size:14px;
font-weight:700;
}

textarea{
display:block;

width:100%;
min-height:120px;

resize:none;

padding:13px;

border:1px solid rgba(255,255,255,.09);
border-radius:14px;

outline:none;

color:#fff;

background:rgba(255,255,255,.045);

line-height:1.8;
font-size:14px;
}

textarea::placeholder{
color:#718399;
}

textarea:focus{
border-color:rgba(37,99,235,.75);
background:rgba(255,255,255,.06);
}

.counter{
margin-top:5px;

text-align:left;

color:#718399;

font-size:10px;
}

/* =========================
   الأزرار
========================= */

.action{
width:100%;
min-height:46px;

margin-top:12px;

border:0;
border-radius:13px;

cursor:pointer;

font-size:14px;
font-weight:800;

transition:.15s;
}

.send{
color:#fff;
background:#2563eb;
}

.send:hover{
background:#3472ed;
}

.comment-button{
color:#dbe5ef;

background:
rgba(255,255,255,.055);

border:1px solid rgba(255,255,255,.08);
}

.comment-button:hover{
background:rgba(255,255,255,.09);
}

button:disabled{
opacity:.55;
cursor:not-allowed;
}

.hidden{
display:none!important;
}

.message{
min-height:24px;

margin-top:10px;

text-align:center;

font-size:13px;
font-weight:700;
}

/* =====================================================
   GOOGLE STYLE — ملخص التقييم
===================================================== */

.reviews-card{
padding:22px 18px;
}

.google-summary{

display:grid;

grid-template-columns:
145px
minmax(0,1fr);

align-items:center;

gap:22px;

padding-bottom:22px;

border-bottom:
1px solid rgba(255,255,255,.07);
}

/* الرقم */

.google-score{
text-align:center;
}

.google-score-number{

font-size:48px;

line-height:1;

font-weight:800;

color:#fff;
}

/* النجوم الصفراء */

.google-stars{

direction:ltr;

margin-top:8px;

color:#ffd43b;

font-size:20px;

line-height:1;

letter-spacing:1px;

white-space:nowrap;
}

/* عدد المراجعات */

.google-review-count{

margin-top:7px;

color:#aebdce;

font-size:12px;
}

/* =========================
   أشرطة Google
========================= */

.google-distribution{

display:flex;

flex-direction:column;

gap:7px;
}

.google-row{

display:grid;

grid-template-columns:
34px
minmax(0,1fr)
32px;

align-items:center;

gap:8px;

min-height:20px;
}

.google-row-label{

direction:ltr;

color:#d9e3ed;

font-size:12px;

font-weight:700;

text-align:left;

white-space:nowrap;
}

.google-bar{

width:100%;

height:8px;

overflow:hidden;

border-radius:99px;

background:
rgba(255,255,255,.10);
}

.google-bar-fill{

width:0;

height:100%;

border-radius:99px;

background:#ffd43b;

transition:
width .45s ease;
}

.google-row-count{

color:#8fa1b5;

font-size:10px;

text-align:left;
}

/* =========================
   المراجعات
========================= */

.reviews-heading{

margin:20px 0 5px;

font-size:20px;

font-weight:800;
}

.review{

padding:17px 0;

border-bottom:
1px solid rgba(255,255,255,.07);
}

.review:last-child{
border-bottom:0;
}

.review-head{

display:flex;

align-items:center;

justify-content:space-between;

gap:10px;
}

.review-user{

min-width:0;

font-size:14px;

font-weight:800;
}

.review-date{

flex-shrink:0;

color:#7f91a6;

font-size:10px;
}

.review-stars{

direction:ltr;

margin-top:5px;

color:#ffd43b;

font-size:16px;

letter-spacing:1px;
}

.review-comment{

margin-top:7px;

color:#d9e3ed;

font-size:13px;

line-height:1.9;

white-space:pre-wrap;

overflow-wrap:anywhere;
}

.developer-reply{

margin-top:11px;

padding:10px 12px;

border-right:
3px solid #2563eb;

border-radius:10px;

background:
rgba(37,99,235,.08);

color:#d9e5f2;

font-size:12px;

line-height:1.8;
}

.developer-reply strong{

display:block;

margin-bottom:2px;

color:#fff;
}

.empty{

padding:25px 5px;

text-align:center;

color:#8fa1b5;

font-size:13px;

line-height:1.9;
}

.back{

display:block;

margin:18px 0 5px;

color:#91acd0;

text-align:center;

text-decoration:none;

font-size:12px;
}

/* =========================
   موبايل
========================= */

@media(max-width:560px){

body{
padding:12px 9px 25px;
}

.hero{
padding:23px 15px 20px;
}

h1{
font-size:23px;
}

.stats{
gap:7px;
}

.stat strong{
font-size:18px;
}

.stat span{
font-size:9px;
}

.rate-card,
.reviews-card{
padding:20px 15px;
}

.star-button{

width:43px;
height:43px;

font-size:36px;
}

.google-summary{

grid-template-columns:
105px
minmax(0,1fr);

gap:13px;
}

.google-score-number{
font-size:40px;
}

.google-stars{
font-size:17px;
}

.google-row{

grid-template-columns:
30px
minmax(0,1fr)
27px;

gap:6px;
}

}

</style>



