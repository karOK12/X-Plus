<script>

const API_URL = "/api";

let selectedRating = null;


/* العناصر */

const stars =
document.querySelectorAll(".star-button");

const ratingText =
document.getElementById("ratingText");

const comment =
document.getElementById("comment");

const charCount =
document.getElementById("charCount");

const sendBtn =
document.getElementById("sendBtn");

const commentOnlyBtn =
document.getElementById("commentOnlyBtn");

const commentOnlyArea =
document.getElementById("commentOnlyArea");

const commentOnly =
document.getElementById("commentOnly");

const commentOnlyCount =
document.getElementById("commentOnlyCount");

const submitCommentOnly =
document.getElementById("submitCommentOnly");

const message =
document.getElementById("message");

const reviews =
document.getElementById("reviews");


/* =====================================================
   التوكن
===================================================== */

function getToken(){

return (
localStorage.getItem("token") ||
localStorage.getItem("auth_token")
);

}


/* =====================================================
   API
===================================================== */

function apiFetch(url, options = {}){

const token =
getToken();

return fetch(
url,
{
...options,

headers:{
"Content-Type":
"application/json",

...(token
? {
Authorization:
`Bearer ${token}`
}
: {}),

...(options.headers || {})
}

}
);

}


/* =====================================================
   نجوم الإدخال
===================================================== */

function showStars(value){

const selected = Number(value);

stars.forEach(star => {

const rating = Number(star.dataset.rating);
const active =
Number.isInteger(selected) &&
selected >= 1 &&
selected <= 5 &&
rating <= selected;

star.classList.toggle("active", active);

star.style.setProperty(
"color",
active ? "#ffd43b" : "#536477",
"important"
);

star.style.setProperty(
"text-shadow",
active
? "0 0 12px rgba(255,212,59,.28)"
: "none",
"important"
);

});

}


stars.forEach(
star => {

star.addEventListener(
"click",
() => {

selectedRating =
Number(star.dataset.rating);

showStars(
selectedRating
);

console.log("⭐ STAR CLICK:", selectedRating);

ratingText.textContent =
`${selectedRating} من 5 ⭐`;

commentOnlyArea
.classList
.add("hidden");

message.textContent =
"";

}
);

}
);


/* =====================================================
   عداد التعليق
===================================================== */

comment.addEventListener(
"input",
() => {

charCount.textContent =
comment.value.length;

}
);


commentOnly.addEventListener(
"input",
() => {

commentOnlyCount.textContent =
commentOnly.value.length;

}
);


/* =====================================================
   التاريخ
===================================================== */

function formatDate(value){

if(!value){
return "";
}

try{

return new Date(value)
.toLocaleDateString(
"ar-IQ",
{
year:"numeric",
month:"long",
day:"numeric"
}
);

}
catch{

return "";

}

}


/* =====================================================
   نجوم المراجعات
===================================================== */

function renderStars(rating){

const n =
Math.max(
0,
Math.min(
5,
Number(rating) || 0
)
);

return (
"★".repeat(n) +
"☆".repeat(5 - n)
);

}


/* =====================================================
   تحديث ملخص Google
===================================================== */

function updateStats(stats){

if(!stats){
return;
}


const average =
Number(
stats.averageRating || 0
);


const total =
Number(
stats.totalRatings || 0
);


const distribution =
stats.distribution || {};


/* المتوسط */

const averageElement =
document.getElementById(
"averageRating"
);

if(averageElement){

averageElement.textContent =
"0.0";

}


/* النجوم */

const averageStars =
document.getElementById(
"averageStars"
);

if(averageStars){

const rounded =
Math.max(
0,
Math.min(
5,
Math.round(average)
)
);

averageStars.textContent =
"★★★★★";

}


/* العدد */

const totalElement =
document.getElementById(
"googleTotalRatings"
);

if(totalElement){

totalElement.textContent =
total;

}


/* العدد الموجود في الأعلى */

const storeRating =
document.getElementById(
"storeRating"
);

if(storeRating){

storeRating.textContent = "★ 0.0";

}


/* الأشرطة */

for(
let i = 1;
i <= 5;
i++
){

const count =
Number(
distribution[i] || 0
);


const countElement =
document.getElementById(
`count${i}`
);


const barElement =
document.getElementById(
`bar${i}`
);


if(countElement){

countElement.textContent =
count;

}


if(barElement){

const percentage =
total > 0
? (count / total) * 100
: 0;

barElement.style.width =
`${percentage}%`;

}

}

}


/* =====================================================
   عرض المراجعات
===================================================== */

function renderReviews(items){

if(
!Array.isArray(items) ||
!items.length
){

reviews.innerHTML = `

<div class="empty">

لا توجد مراجعات بعد.<br>

كن أول من يشارك تجربته.

</div>

`;

return;

}


reviews.innerHTML =
items.map(
review => {


const rating =
review.rating !== null &&
review.rating !== undefined

? `

<div class="review-stars">

${renderStars(
review.rating
)}

</div>

`

: "";


const reply =
review.developerReply

? `

<div class="developer-reply">

<strong>
رد فريق X Plus
</strong>

<div>
${escapeHtml(
review.developerReply
)}
</div>

</div>

`

: "";


return `

<article class="review">


<div class="review-head">

<div class="review-user">

${escapeHtml(
review.username ||
"مستخدم"
)}

</div>


<div class="review-date">

${formatDate(
review.createdAt
)}

</div>

</div>


${rating}


<div class="review-comment">

${escapeHtml(
review.comment || ""
)}

</div>


${reply}


</article>

`;

}
).join("");

}


/* =====================================================
   حماية HTML
===================================================== */

function escapeHtml(value){

return String(value)

.replaceAll(
"&",
"&amp;"
)

.replaceAll(
"<",
"&lt;"
)

.replaceAll(
">",
"&gt;"
)

.replaceAll(
'"',
"&quot;"
)

.replaceAll(
"'",
"&#039;"
);

}


/* =====================================================
   تحميل التقييم
===================================================== */

async function loadRating(){

if(!getToken()){

window.location.href =
"login.html";

return;

}


try{

const res =
await apiFetch(
`${API_URL}/rating`
);


const data =
await res.json();


if(
!res.ok ||
!data.success
){

throw new Error(
data.message ||
"تعذر تحميل التقييمات"
);

}


/* إذا المستخدم قيّم سابقاً */

if(
data.rating !== null &&
data.rating !== undefined &&
Number(data.rating) >= 1
){

ratingText.textContent =
"تم تسجيل تقييمك";

}


/* تعليق المستخدم */

if(data.comment){

comment.value =
data.comment;

charCount.textContent =
data.comment.length;

}


/* تحديث البيانات */

updateStats(
data.stats
);


/* عرض المراجعات */

renderReviews(
data.reviews
);

}

catch(err){

console.error(err);

reviews.innerHTML = `

<div class="empty">

تعذر تحميل المراجعات حاليًا.

</div>

`;

}

}


/* =====================================================
   إرسال التقييم
===================================================== */

async function submitParticipation(
ratingValue
){

const text =
comment.value.trim();


if(
!ratingValue &&
!text
){

message.textContent =
"⚠️ اختر تقييمًا أو اكتب تعليقًا أولًا.";

return;

}


if(
text.length > 500
){

message.textContent =
"⚠️ التعليق يجب ألا يتجاوز 500 حرف.";

return;

}


sendBtn.disabled =
true;

commentOnlyBtn.disabled =
true;


message.textContent =
"⏳ جاري إرسال مشاركتك...";


try{

const res =
await apiFetch(
`${API_URL}/rating`,
{
method:"POST",

body:
JSON.stringify(
{
rating:
ratingValue || null,

comment:
text || null
}
)
}
);


const data =
await res.json();


if(
!res.ok ||
!data.success
){

throw new Error(
data.message ||
"فشل نشر المراجعة"
);

}


message.textContent =
"✅ تم حفظ مشاركتك بنجاح.";


await loadRating();

}

catch(err){

console.error(err);

message.textContent =
`❌ ${
err.message ||
"حدث خطأ أثناء الحفظ"
}`;

}

finally{

sendBtn.disabled =
false;

commentOnlyBtn.disabled =
false;

}

}


/* زر التقييم */

sendBtn.addEventListener(
"click",
() => {

submitParticipation(
selectedRating
);

}
);


/* =====================================================
   تعليق بدون تقييم
===================================================== */

commentOnlyBtn.addEventListener(
"click",
() => {

document
.getElementById(
"ratingCommentArea"
)
.classList
.add("hidden");


showStars(null);

selectedRating =
null;


ratingText.textContent =
"تعليق بدون تقييم";


commentOnlyArea
.classList
.remove("hidden");


message.textContent =
"";


commentOnly.focus();

}
);


/* =====================================================
   إرسال التعليق فقط
===================================================== */

submitCommentOnly.addEventListener(
"click",
async () => {

const text =
commentOnly.value.trim();


if(!text){

message.textContent =
"⚠️ اكتب تعليقك أولًا.";

commentOnly.focus();

return;

}


if(
text.length > 500
){

message.textContent =
"⚠️ التعليق يجب ألا يتجاوز 500 حرف.";

return;

}


submitCommentOnly.disabled =
true;


message.textContent =
"⏳ جاري نشر التعليق...";


try{

const res =
await apiFetch(
`${API_URL}/rating`,
{
method:"POST",

body:
JSON.stringify(
{
rating:null,
comment:text
}
)
}
);


const data =
await res.json();


if(
!res.ok ||
!data.success
){

throw new Error(
data.message ||
"فشل نشر التعليق"
);

}


message.textContent =
"✅ تم نشر تعليقك بنجاح.";


commentOnly.value =
"";

commentOnlyCount.textContent =
"0";


commentOnlyArea
.classList
.add("hidden");


document
.getElementById(
"ratingCommentArea"
)
.classList
.remove("hidden");


await loadRating();

}

catch(err){

console.error(err);

message.textContent =
`❌ ${
err.message ||
"حدث خطأ أثناء النشر"
}`;

}

finally{

submitCommentOnly.disabled =
false;

}

}
);


/* =====================================================
   تشغيل الصفحة
===================================================== */

loadRating();



</script>



